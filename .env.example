# BanglaShield AI — environment configuration
# Copy to .env and adjust:  cp .env.example .env

# SQLite database file. NOTE: the path is resolved relative to prisma/schema.prisma,
# so ../db/custom.db points at <repo>/db/custom.db.
DATABASE_URL="file:../db/custom.db"

# HMAC key used to sign analyst session cookies (server-side only).
# IMPORTANT: set a long random value in production, e.g.  openssl rand -hex 32
SESSION_SECRET="change-me-in-production"

# The AI provider (z-ai-web-dev-sdk) is configured by the runtime environment;
# no API keys belong in this file or in the client bundle.

# Demo analyst account is created by `bun run db:seed` with the credentials
# documented in README.md ("Demo analyst account"). Change them before any
# real deployment: they are demo-environment credentials, never production ones.
